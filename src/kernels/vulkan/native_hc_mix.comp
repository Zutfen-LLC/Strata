#version 450
#extension GL_EXT_spirv_intrinsics : require
#extension GL_GOOGLE_include_directive : require
#include "../../core/native_hc_mix_limits.h"
#ifdef STRATA_HC_HEAD_DIV_RN
#include "native_f32_div_rn.glsl"
#endif
spirv_instruction(extensions=["SPV_KHR_fma"],capabilities=[6030],id=4427)
float hc_fma(float a,float b,float c);
layout(local_size_x=256) in;
layout(binding=0,std430) readonly buffer X {float x[];};
layout(binding=1,std430) readonly buffer G {float gates[];};
layout(binding=2,std430) readonly buffer W {uint weights[];};
layout(binding=3,std430) writeonly buffer P {float pre[];};
layout(binding=4,std430) writeonly buffer A {float activation[];};
layout(binding=5,std430) writeonly buffer O {float output_values[];};
layout(binding=6,std430) buffer S {uint status[];};
layout(push_constant) uniform Params {uint mode,tokens,xb,gb,wb,pb,ab,ob,sb;} p;
shared float sums[256];
void flag(uint reason){atomicOr(status[p.sb],reason<<(8u*p.mode));}
float checked(float v){uint b=floatBitsToUint(v)&0x7fffffffu;if(b>=0x7f800000u)flag(1u);if(b>0u&&b<0x800000u)flag(2u);return v;}
void activate(float v,bool silu,out float e,out float a){
 uint vb=floatBitsToUint(v)&0x7fffffffu;
 bool positive_tail=!silu&&vb<0x7f800000u&&v>uintBitsToFloat(STRATA_HC_MIX_ACTIVATION_LIMIT_BITS);
 bool overflow_tail=!silu&&vb<0x7f800000u&&v<=-89.0;
 if(!positive_tail&&!overflow_tail&&vb>STRATA_HC_MIX_ACTIVATION_LIMIT_BITS)flag(4u);
 e=exp(-v);precise float den=1.0+e;
#ifdef STRATA_HC_HEAD_DIV_RN
 // This head-only observation fixes the captured SiLU division operands;
 // exp and reciprocal remain native-device observations, not parity claims.
 precise float result=silu?uintBitsToFloat(strata_f32_div_rn_bits(floatBitsToUint(v),floatBitsToUint(den))):1.0/den;
#else
 precise float result=silu?v/den:1.0/den;
#endif
 a=result;
 if(positive_tail){
  // exp may underflow, but the unchanged rounded denominator must be one.
  uint eb=floatBitsToUint(e);if(eb>0x33800000u||den!=1.0||floatBitsToUint(a)!=0x3f800000u)flag(8u);
 }else if(overflow_tail){
  // ceil(log(FLT_MAX))=89: only observed +Inf and exact +0 are admitted.
  // No replacement/saturation is assigned to e, den or result.
  if(floatBitsToUint(e)!=0x7f800000u||floatBitsToUint(den)!=0x7f800000u||floatBitsToUint(a)!=0u)flag(8u);
 }else{
  checked(e);checked(den);
  if(!(e>0.0)||(floatBitsToUint(e)&0x7fffffffu)<0x00800000u)flag(8u);
  if(den>uintBitsToFloat(STRATA_HC_MIX_MAX_DENOMINATOR_BITS))flag(16u);
  float top=silu?v:1.0;precise float minimum=uintBitsToFloat(STRATA_HC_MIX_MIN_QUOTIENT_BITS)*den;
  if((floatBitsToUint(top)&0x7fffffffu)!=0u&&abs(top)<minimum)flag(32u);
  checked(a);if(top!=0.0&&a==0.0)flag(64u);
 }
}
void main(){uint tid=gl_LocalInvocationID.x,row=gl_WorkGroupID.x;
 if(p.mode==3u){uint i=row*256u+tid;if(i<10240u){float e,a;activate(checked(x[p.xb+i]),false,e,a);output_values[p.ob+i]=e;activation[p.ab+i]=a;}return;}

 if(p.mode<2u){uint width=p.mode==0u?10240u:320u;precise float acc=0.0;
  // Native eight-FMA chunks, then chunk addition, then logical warp XOR.
  if(tid<32u)for(uint chunk=tid;chunk<width/8u;chunk+=32u){precise float d=0.0;for(uint k=0u;k<8u;++k){uint j=chunk*8u+k,at=row*width+j,word=weights[p.wb+at/2u];float w=uintBitsToFloat(at%2u==0u?word<<16:word&0xffff0000u);d=checked(hc_fma(checked(w),checked(x[p.xb+j]),d));}if(p.mode==1u&&chunk==tid)acc=d;else acc=checked(acc+d);}
  sums[tid]=acc;barrier();for(uint offset=16u;offset>0u;offset>>=1u){precise float next=sums[tid]+sums[tid^offset];barrier();sums[tid]=checked(next);barrier();}
  if(tid==0u){precise float v=sums[0];if(p.mode==0u)v=checked(v*0.25);pre[p.pb+row]=v;
   float e,a;activate(v,p.mode==0u,e,a);output_values[p.ob+row]=e;activation[p.ab+row]=a;}

 }else{uint d=row*256u+tid;if(d>=2560u)return;precise float s=0.0;for(uint c=0u;c<4u;++c){precise float term=checked(checked(x[p.xb+c*2560u+d])*checked(gates[p.gb+c*2560u+d]));s=checked(s+term);}precise float mean=s*0.25;output_values[p.ob+d]=checked(mean);}
}
