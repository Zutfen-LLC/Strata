#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive : require
// native_gu_kernel<8>, Fmt<8>/row_dot: eight logical 32-lane rows.
// Shared memory makes the XOR tree independent of physical subgroup width.
layout(local_size_x=256) in;
layout(binding=0,std430) readonly buffer X {uint x[];};
layout(binding=1,std430) readonly buffer M {int m[];};
layout(binding=2,std430) writeonly buffer G {float gate[];};
layout(binding=3,std430) writeonly buffer U {float up[];};
layout(push_constant) uniform P {uint h,f,xb,mb,gb,ub,scale_bits;} p;
#include "native_q8_abi.h"
#include "native_q8_dot.glsl"
void main() {
    uint tid=gl_LocalInvocationID.x,lane=tid%32,warp=tid/32;
    uint row=gl_WorkGroupID.x*8+warp,nb=p.h/32;
    // Host validation makes 2*f a multiple of eight: no divergent barriers.
    for(uint group=gl_WorkGroupID.y;group<uint(m[p.mb]);group+=gl_NumWorkGroups.y) {
        uint address_word=p.mb+STRATA_Q8_ADDRESS_WORD+2*group;
        uint64_t base=(uint64_t(uint(m[address_word+1]))<<32)|uint64_t(uint(m[address_word]));
        base+=uint64_t(row)*nb*34;
        for(int e=m[p.mb+STRATA_Q8_START_WORD+group];e<m[p.mb+STRATA_Q8_START_WORD+1+group];++e) {
            uint token=uint(m[p.mb+STRATA_Q8_ID_WORD+e]);
            float dot=q8_row_dot(base,token,nb,tid);
            if(lane==0) {
                precise float value=dot*uintBitsToFloat(p.scale_bits); // native pure-Q8 scale
                if(row<p.f)gate[p.gb+uint(e)*p.f+row]=value;
                else up[p.ub+uint(e)*p.f+row-p.f]=value;
            }
            barrier();
        }
    }
}
