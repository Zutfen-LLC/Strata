#extension GL_EXT_spirv_intrinsics : require
spirv_instruction(extensions=["SPV_KHR_fma"],capabilities=[6030],id=4427) float nfma(float a,float b,float c);
#extension GL_GOOGLE_include_directive : require
#include "native_f32_div_rn.glsl"
layout(local_size_x=256) in;
layout(binding=0,std430) readonly buffer S{float scratch[];};
layout(binding=1,std430) writeonly buffer O{float attn[];};
layout(binding=2,std430) buffer A{float aux[];};
layout(binding=3,std430) buffer E{uint status[];};
layout(push_constant) uniform Params{uint off[4];}p;
float ck(float v){uint a=floatBitsToUint(v)&0x7fffffffu;if(a>=0x7f800000u||(a!=0u&&a<0x800000u))atomicOr(status[p.off[3]],1u);return v;}
float maximum(float a,float b){return a==0.0&&b==0.0?uintBitsToFloat(floatBitsToUint(a)&floatBitsToUint(b)):max(a,b);}
void main(){uint h=gl_WorkGroupID.x,d=gl_LocalInvocationID.x,kvh=h/12u,hl=h%12u;float M=-uintBitsToFloat(0x7f7fffffu);for(uint c=0u;c<33u;++c)M=maximum(M,scratch[p.off[0]+202752u+(kvh*33u+c)*12u+hl]);
 precise float L=0.0,acc=0.0;for(uint c=0u;c<33u;++c){uint slot=kvh*33u+c;float m=scratch[p.off[0]+202752u+slot*12u+hl];if(m==-uintBitsToFloat(0x7f7fffffu))continue;precise float delta=ck(m-M);float w=ck(exp(delta));if(d==0u)aux[p.off[2]+h*33u+c]=w;L=ck(nfma(ck(scratch[p.off[0]+203544u+slot*12u+hl]),w,L));acc=ck(nfma(ck(scratch[p.off[0]+(slot*12u+hl)*256u+d]),w,acc));}
 if(d==0u){aux[p.off[2]+792u+h]=M;aux[p.off[2]+816u+h]=L;}aux[p.off[2]+840u+h*256u+d]=acc;
 float outv=L>0.0?ck(uintBitsToFloat(strata_f32_div_rn_bits(floatBitsToUint(acc),floatBitsToUint(L)))):0.0;attn[p.off[1]+h*256u+d]=outv;
}
