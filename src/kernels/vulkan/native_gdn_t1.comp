#version 450
#extension GL_EXT_spirv_intrinsics : require
#extension GL_GOOGLE_include_directive : require
#include "../../core/native_hc_mix_limits.h"
spirv_instruction(extensions=["SPV_KHR_fma"],capabilities=[6030],id=4427) float nfma(float a,float b,float c);
// verify_kernels.cu: S=128, RG=4, RPG=32. x=state column, y=row group.
layout(local_size_x=128,local_size_y=4) in;
layout(binding=0,std430) readonly buffer ST {float st[];};
layout(binding=1,std430) readonly buffer H {float h[];};
layout(binding=2,std430) readonly buffer G {float gate[];};
layout(binding=3,std430) readonly buffer B {float beta[];};
layout(binding=4,std430) readonly buffer Z {float z[];};
layout(binding=5,std430) readonly buffer W {float gamma[];};
layout(binding=6,std430) writeonly buffer NS {float ns[];};
layout(binding=7,std430) writeonly buffer Y {float y[];};
