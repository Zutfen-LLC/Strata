layout(binding=8,std430) buffer AUX {float aux[];};
layout(binding=9,std430) buffer OC {float oc_out[];};
layout(binding=10,std430) buffer STATUS {uint status[];};
layout(push_constant) uniform P {uint off[14];} p;
shared float kvpart[512],opart[512],normpart[512],wsum[4];
float ck(float v){uint b=floatBitsToUint(v)&0x7fffffffu;if(b>=0x7f800000u||(b!=0u&&b<0x800000u))atomicOr(status[p.off[13]],1u);return v;}
void main(){uint head=gl_WorkGroupID.x,col=gl_LocalInvocationID.x,rg=gl_LocalInvocationID.y,id=rg*128u+col;
 uint qh=head%16u;float s[32];precise float kv=0.0;
 for(uint r=0u;r<32u;++r){s[r]=ck(st[p.off[0]+((rg*32u+r)*48u+head)*128u+col]);kv=ck(nfma(s[r],ck(h[p.off[1]+2048u+qh*128u+rg*32u+r]),kv));}
 kvpart[id]=kv;barrier();
 precise float kvcol=ck(ck(ck(kvpart[col]+kvpart[128u+col])+kvpart[256u+col])+kvpart[384u+col]);
 float gv=exp(ck(gate[p.off[2]+head]));gv=ck(gv);if(id==0u)aux[p.off[8]+head]=gv;
 // CUDA defaults contract v-g*kv in this expression; explicit native FMA candidate,
 // independently checked against the actual launcher before qualification.
 precise float delta=ck(ck(nfma(-gv,kvcol,ck(h[p.off[1]+4096u+head*128u+col])))*ck(beta[p.off[3]+head]));
 precise float o=0.0;
 for(uint r=0u;r<32u;++r){precise float update=ck(ck(h[p.off[1]+2048u+qh*128u+rg*32u+r])*delta);s[r]=ck(nfma(gv,s[r],update));ns[p.off[6]+((rg*32u+r)*48u+head)*128u+col]=s[r];o=ck(nfma(s[r],ck(h[p.off[1]+qh*128u+rg*32u+r]),o));}
 opart[id]=o;barrier();precise float oc=0.0;precise float sq=0.0;
 if(rg==0u){oc=ck(ck(ck(ck(opart[col]+opart[128u+col])+opart[256u+col])+opart[384u+col])*inversesqrt(128.0));sq=ck(oc*oc);oc_out[p.off[9]+head*128u+col]=oc;}
 normpart[id]=sq;barrier();
 for(uint offset=16u;offset>0u;offset>>=1u){precise float next=ck(normpart[id]+normpart[rg*128u+(col^offset)]);barrier();normpart[id]=next;barrier();}
 if(rg==0u&&(col&31u)==0u)wsum[col>>5u]=normpart[id];barrier();
 if(rg==0u){precise float sum=ck(ck(ck(wsum[0]+wsum[1])+wsum[2])+wsum[3]);precise float mean=ck(sum/128.0);precise float shifted=ck(mean+0.000001);float scale=ck(inversesqrt(shifted));if(col==0u){aux[p.off[10]+head]=scale;if(head==0u)aux[p.off[10]+48u]=inversesqrt(128.0);}
  // Same native expression, including natural exp underflow/+Inf and 1/0 tails.
  // Class checks never assign replacements to exp, denominator or sigmoid.
  float zz=ck(z[p.off[4]+head*128u+col]);float ev=exp(-zz);precise float denominator=1.0+ev;precise float sigmoid=1.0/denominator;
  bool positive_tail=zz>uintBitsToFloat(STRATA_HC_MIX_ACTIVATION_LIMIT_BITS),overflow_tail=zz<=-89.0;
  if(positive_tail){if(floatBitsToUint(ev)>0x33800000u||denominator!=1.0||floatBitsToUint(sigmoid)!=0x3f800000u)atomicOr(status[p.off[13]],2u);}
  else if(overflow_tail){if(floatBitsToUint(ev)!=0x7f800000u||floatBitsToUint(denominator)!=0x7f800000u||floatBitsToUint(sigmoid)!=0u)atomicOr(status[p.off[13]],2u);}
  else{ck(ev);ck(denominator);ck(sigmoid);if(!(ev>0.0)||denominator>uintBitsToFloat(STRATA_HC_MIX_MAX_DENOMINATOR_BITS)||sigmoid==0.0)atomicOr(status[p.off[13]],2u);}
  aux[p.off[11]+head*128u+col]=ev;aux[p.off[12]+head*128u+col]=sigmoid;
  precise float a=ck(oc*scale);precise float b=ck(a*ck(gamma[p.off[5]+col]));precise float result=ck(b*sigmoid);y[p.off[7]+head*128u+col]=result;
 }
}
