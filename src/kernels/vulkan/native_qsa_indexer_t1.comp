layout(local_size_x=256) in;
layout(binding=0,std430) readonly buffer X{float raw[];};
layout(binding=1,std430) readonly buffer W{float gamma[];};
layout(binding=2,std430) readonly buffer B{uint before[];};
layout(binding=3,std430) writeonly buffer O{uint candidate[];};
layout(binding=4,std430) writeonly buffer D{float diag[];};
layout(binding=5,std430) buffer S{uint status[];};
layout(push_constant) uniform Params{uint off[6];uint cells;uint pos;uint base;uint theta;}p;
shared float values[128],partial[256],sums[8];
float ck(float a){uint b=floatBitsToUint(a)&0x7fffffffu;if(b>=0x7f800000u||(b!=0u&&b<0x800000u))atomicOr(status[p.off[5]],1u);return a;}
// Reuse Strata's existing integer RNE binary16 converter, without packHalf's
// implementation-dependent denormal treatment. Expansion is exact integer work.
uint half_rne(float x) {
    uint b=floatBitsToUint(x), sign=(b>>16)&0x8000u;
    uint e=(b>>23)&255u, m=b&0x7fffffu;
    if(e==255u) return sign|0x7c00u|(m==0u?0u:0x200u|(m>>13));
    if(e>142u) return sign|0x7c00u;
    if(e<102u) return sign;
    uint sig=m|0x800000u;
    uint shift=e<113u?126u-e:13u;
    uint q=sig>>shift, rem=sig&((1u<<shift)-1u), halfway=1u<<(shift-1u);
    q+=uint(rem>halfway || (rem==halfway && (q&1u)!=0u));
    return sign|(e<113u?q:((e-113u)<<10)+q);
}
float expand_half(uint h){uint sign=(h&0x8000u)<<16,e=(h>>10)&31u,m=h&1023u;if(e==0u){if(m==0u)return uintBitsToFloat(sign);uint shift=0u;while((m&1024u)==0u){m<<=1u;++shift;}return uintBitsToFloat(sign|((113u-shift)<<23)|((m&1023u)<<13));}return uintBitsToFloat(sign|((e+112u)<<23)|(m<<13));}
void main(){uint tid=gl_LocalInvocationID.x,lane=tid&31u,block=512u+(p.cells/4u+1u)*128u,words=block+1u;
