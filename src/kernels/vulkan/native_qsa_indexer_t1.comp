 for(uint i=tid;i<386u;i+=256u)diag[p.off[4]+i]=0.0;
 barrier();
 float incoming=0.0,mean=0.0;
 if(tid<128u){incoming=expand_half(half_rne(raw[p.off[0]+tid]));ck(incoming);diag[p.off[4]+tid]=incoming;if(p.pos%4u<3u)candidate[p.off[3]+(p.pos%4u)*128u+tid]=floatBitsToUint(incoming);}
 bool completes=p.pos==0u||p.pos%4u==3u;
 if(!completes)return;
 if(tid<128u){precise float sum=p.pos==0u?incoming:uintBitsToFloat(before[p.off[2]+tid]);for(uint j=1u;j<4u;++j){precise float v=p.pos==0u||j==3u?incoming:uintBitsToFloat(before[p.off[2]+j*128u+tid]);sum=ck(sum+v);}mean=ck(nfma(.25,sum,0.0));diag[p.off[4]+128u+tid]=mean;}
 partial[tid]=ck(nfma(mean,mean,0.0));barrier();
 for(uint d=16u;d>0u;d>>=1u){precise float a=ck(partial[tid]+partial[tid^d]);barrier();partial[tid]=a;barrier();}
 if(lane==0u)sums[tid/32u]=partial[tid];barrier();partial[tid]=lane<8u?sums[lane]:0.0;barrier();
 for(uint d=16u;d>0u;d>>=1u){precise float a=ck(partial[tid]+partial[tid^d]);barrier();partial[tid]=a;barrier();}
 precise float ms=ck(partial[tid]/128.0);precise float arg=ck(ms+1e-6);float rs=ck(inversesqrt(arg));if(tid==0u){diag[p.off[4]+256u]=arg;diag[p.off[4]+257u]=rs;}
 if(tid<128u){precise float scaled=ck(rs*mean);values[tid]=ck(scaled*gamma[p.off[1]+tid]);}barrier();
 if(tid<128u){uint b=p.pos/4u;float y=values[tid];if(tid<64u){uint pair=tid%32u;float freq=pow(uintBitsToFloat(p.theta),float(pair));precise float angle=ck(float(p.pos==0u?0u:p.base+4u*b)*freq);float c=cos(angle),s=sin(angle);ck(freq);ck(c);ck(s);precise float product=ck(values[pair+32u]*(tid<32u?s:c));y=ck(nfma(values[pair],tid<32u?c:s,tid<32u?-product:product));if(tid<32u){uint d=p.off[4]+258u+tid;diag[d]=freq;diag[d+32u]=angle;diag[d+64u]=c;diag[d+96u]=s;}}
 candidate[p.off[3]+512u+b*128u+tid]=floatBitsToUint(y);if(p.pos==0u)candidate[p.off[3]+384u+tid]=floatBitsToUint(y);else candidate[p.off[3]+512u+(b+1u)*128u+tid]=before[p.off[2]+384u+tid];if(tid==0u&&p.pos!=0u)candidate[p.off[3]+block]=p.base+4u*b;
 }
