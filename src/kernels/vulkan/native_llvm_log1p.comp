#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_GOOGLE_include_directive : require
#include "native_llvm_log1p.glsl"
layout(local_size_x=256) in;
layout(binding=0,std430) readonly buffer X{float x[];};
layout(binding=1,std430) writeonly buffer Y{float y[];};
layout(binding=2,std430) writeonly buffer D{uint wide[];};
layout(binding=3,std430) writeonly buffer P{uint path[];};
layout(push_constant) uniform Params{uint off[4];}p;
void main(){uint i=gl_LocalInvocationID.x;double d;uint kind;y[p.off[1]+i]=strata_llvm_log1p(x[p.off[0]+i],d,kind);uvec2 b=unpackDouble2x32(d);wide[p.off[2]+2*i]=b.x;wide[p.off[2]+2*i+1]=b.y;path[p.off[3]+i]=kind;}
