# Specific build-only embedding for the native stages shader.
file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" length)
math(EXPR remainder "${length} % 8")
if(NOT remainder EQUAL 0 OR length LESS 40)
  message(FATAL_ERROR "native stages: invalid SPIR-V byte length")
endif()
set(words "")
math(EXPR last "${length} - 8")
foreach(offset RANGE 0 ${last} 8)
  string(SUBSTRING "${hex}" ${offset} 8 word)
  string(SUBSTRING "${word}" 0 2 a)
  string(SUBSTRING "${word}" 2 2 b)
  string(SUBSTRING "${word}" 4 2 c)
  string(SUBSTRING "${word}" 6 2 d)
  string(APPEND words "0x${d}${c}${b}${a}u,\n")
endforeach()
file(WRITE "${OUTPUT}" "#pragma once\n#include <cstdint>\nalignas(4) static const uint32_t strata_q8_gu_spv[] = {\n${words}};\n")
