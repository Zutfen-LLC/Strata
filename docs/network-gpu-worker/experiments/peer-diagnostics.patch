+    def drain_stderr(self):
+        # Bounded work and memory; stderr never grants progress/lease coverage.
+        if self.stderr_eof or not self.stderr_nonblocking:
+            return
+        for _ in range(16):
+            try:
+                raw = os.read(self.process.stderr.fileno(), 4096)
+            except BlockingIOError:
+                break
+            if not raw:
+                self.stderr_eof = True
+                break
+            self.stderr_bytes += len(raw)
+            self.stderr_tail.extend(raw)
+            del self.stderr_tail[:-65536]
+
+    def save_diagnostics(self):
+        if self.diagnostic_path is None:
+            return
+        value = {"run_id": self.run_id, "role": self.role,
+                 "final_packet": self.terminal_packet, "exit_status": self.exit_status,
+                 "exit_status_scope": "controller-owned peer transport, possibly stopped by cleanup; not resident worker",
+                 "stderr_tail": self.stderr_tail.decode("utf-8", errors="replace"),
+                 "stderr_bytes_observed": self.stderr_bytes,
+                 "stderr_capture_ready": self.stderr_nonblocking,
+                 "stderr_tail_truncated": self.stderr_bytes > len(self.stderr_tail),
+                 "stderr_eof_observed": self.stderr_eof}
+        raw = json.dumps(value, allow_nan=False).encode("ascii")
+        if len(raw) > 512 * 1024:
+            raise CoverageError("peer-diagnostic-cap")
+        temporary = self.diagnostic_path + ".tmp"
+        with open(temporary, "wb") as output:
+            output.write(raw)
+        os.replace(temporary, self.diagnostic_path)
+
