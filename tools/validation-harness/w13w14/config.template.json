{
  "_comment": "Template for a resident CPU worker-count comparison campaign. Copy to the campaign root as config.json, substitute every __PLACEHOLDER__, then pin exact sha256s of engine/worker/manifest/requests and enforce them in preflight (see w13w14/README.md).",
  "argv": [
    "__CAMPAIGN_ROOT__/strata-engine",
    "--serve",
    "--native",
    "__MODEL_GGUF_PATH__",
    "--pack",
    "__NATIVE_PACK_DIR__",
    "--greedy",
    "--pool-workers", "__ENGINE_POOL_WORKERS__",
    "--pool-affinity", "all",
    "--ple-io", "direct",
    "--expert-cache", "__GPU0_EXPERT_SLOTS__",
    "--expert-cache-per-layer",
    "--expert-profile", "__EXPERT_PROFILE_PATH__",
    "--vram-reserve-mib", "__VRAM_RESERVE_MIB__",
    "--adapt-every", "0",
    "--adapt-swaps", "0",
    "--pcie-frac", "0",
    "--short-read", "64",
    "--prefill", "64",
    "--prompt-cache", "0",
    "--spec", "2",
    "--suffix-draft", "0",
    "--lookup-chain", "0",
    "--pipeline-windows", "0",
    "--max-context", "1024",
    "--expert-cache-device1", "__GPU1_EXPERT_SLOTS__",
    "--remote-expert-opt",
    "--mmap-experts",
    "--remote-cpu-experts", "127.0.0.1:__WORKER_PORT__",
    "--remote-cpu-deadline-ms", "10000",
    "--remote-cpu-local-manifest", "__CAMPAIGN_ROOT__/local.manifest",
    "--remote-cpu-resident",
    "--remote-cpu-setup-ms", "600000"
  ],
  "worker_argv": [
    "__CAMPAIGN_ROOT__/strata-expert-worker",
    "--port", "__WORKER_PORT__",
    "--memory-budget-mib", "__WORKER_MEMORY_BUDGET_MIB__",
    "--workers", "__WORKER_POOL_COUNT__",
    "--deadline-ms", "10000",
    "--local-root", "__LOCAL_MODEL_ROOT__",
    "--local-manifest", "__CAMPAIGN_ROOT__/local.manifest",
    "--local-load-threads", "4",
    "--local-setup-ms", "600000",
    "--residency-forever"
  ],
  "env": {
    "OMP_NUM_THREADS": "2",
    "PATH": "/usr/bin:/bin",
    "LANG": "C",
    "LC_ALL": "C",
    "CUDA_DEVICE_ORDER": "PCI_BUS_ID",
    "STRATA_IO_PF_THREADS": "2",
    "STRATA_ROUTE_TAIL_SKIP": "0",
    "STRATA_LOOKAHEAD": "0",
    "STRATA_LOOKAHEAD_STATS": "0",
    "STRATA_FS_SLOTS": "0"
  },
  "gpu_uuids": ["__GPU0_UUID__", "__GPU1_UUID__"],
  "port": "__WORKER_PORT__",
  "binary_sha256": "__ENGINE_SHA256__",
  "worker_sha256": "__WORKER_SHA256__",
  "manifest_sha256": "__LOCAL_MANIFEST_SHA256__",
  "product_revision": "__PRODUCT_GIT_SHA__",
  "experiment": "__EXPERIMENT_NAME__"
}
